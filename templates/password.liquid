{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ shop.name }} &mdash; Coming soon</title>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
{{ 'site.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
</head>
<body>
<main class="password-page">
  <div class="hero-ring"><img src="{{ 'logo.png' | asset_url }}" alt=""></div>
  <span class="eyebrow">Pre-launch</span>
  <h1>GlowBall Industries is prepping for launch</h1>
  {%- if shop.password_message != blank -%}
    <p class="password-message">{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'storefront_password', class: 'password-form' -%}
    <label for="storefrontPassword" class="field">
      <span>Have the password?</span>
    </label>
    <div class="signup-form">
      <input type="password" id="storefrontPassword" name="password" autocomplete="current-password" placeholder="Store password" required>
      <button type="submit" class="btn btn-solid">Enter</button>
    </div>
    {%- if form.errors -%}
      <p class="form-error" role="alert">That password didn't work. Try again.</p>
    {%- endif -%}
  {%- endform -%}

  <p class="password-admin">Store owner? <a href="/admin">Log in here</a></p>
</main>
</body>
</html>
