<section class="faq section-pad" id="faq">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Mission briefing</span>
      <h2>Frequently asked questions</h2>
    </div>
    <div class="faq-list">
      {%- for block in section.blocks -%}
      <div class="faq-item{% if forloop.first %} open{% endif %}" {{ block.shopify_attributes }}>
        <button class="faq-q" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">{{ block.settings.question }} <span class="plus">+</span></button>
        <div class="faq-a">{{ block.settings.answer }}</div>
      </div>
      {%- endfor -%}
    </div>
    {%- if pages['faq'].url != blank -%}
    <div class="faq-more"><a href="{{ pages['faq'].url }}">View the full FAQ &rarr;</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "question", "settings": { "question": "How long do they actually glow?", "answer": "<p>After a full charge under direct light, expect several hours of visible glow, brightest in the first hour and gradually fading. Exact duration depends on the charge source — confirm final numbers from your own testing before publishing them.</p>" } },
      { "type": "question", "settings": { "question": "Can I recharge them?", "answer": "<p>Yes — the photoluminescent core recharges under any light source, including sunlight, a phone flashlight, or a car headlight between holes.</p>" } },
      { "type": "question", "settings": { "question": "Are they legal for tournament play?", "answer": "<p>Weight, size and construction should match standard regulation golf balls, but conformance depends on final manufacturing. Verify against the current USGA/R&A equipment rules before making this claim publicly.</p>" } },
      { "type": "question", "settings": { "question": "Do you offer wholesale or corporate orders?", "answer": "<p>Yes — bulk pricing and custom branding are available for corporate gifting and tournaments. Reach out through the Custom Orders page to start a quote.</p>" } }
    ]
  }
}
{% endschema %}
