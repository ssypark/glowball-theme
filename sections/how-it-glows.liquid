<section class="glows section-pad" id="glows">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Golf systems division</span>
      <h2>How it glows</h2>
    </div>
    <div class="steps">
      <div class="step">
        <span class="step-num">01 / CHARGE</span>
        <div class="step-diagram">
          <svg viewBox="0 0 150 120" fill="none">
            <circle cx="75" cy="60" r="34" stroke="#1ee1ff" stroke-width="2"/>
            <line x1="75" y1="10" x2="75" y2="22" stroke="#ff911e" stroke-width="2"/>
            <line x1="120" y1="60" x2="132" y2="60" stroke="#ff911e" stroke-width="2"/>
            <line x1="107" y1="28" x2="115" y2="20" stroke="#ff911e" stroke-width="2"/>
            <line x1="43" y1="28" x2="35" y2="20" stroke="#ff911e" stroke-width="2"/>
          </svg>
        </div>
        <h3>Expose to light</h3>
        <p>10&ndash;15 minutes under sun or a bright bulb charges the photoluminescent core to full brightness.</p>
      </div>
      <div class="step">
        <span class="step-num">02 / DEPLOY</span>
        <div class="step-diagram">
          <svg viewBox="0 0 150 120" fill="none">
            <circle cx="40" cy="90" r="6" fill="#5aff8c"/>
            <path d="M40 90 Q90 20 130 30" stroke="#5aff8c" stroke-width="2" stroke-dasharray="4 5"/>
            <circle cx="130" cy="30" r="4" fill="#5aff8c"/>
          </svg>
        </div>
        <h3>Tee it up</h3>
        <p>Same feel, flight and regulation size as a standard ball &mdash; the glow doesn't change the game.</p>
      </div>
      <div class="step">
        <span class="step-num">03 / TRACK</span>
        <div class="step-diagram">
          <svg viewBox="0 0 150 120" fill="none">
            <rect x="30" y="20" width="90" height="80" stroke="#2b2b31" stroke-width="1"/>
            <circle cx="75" cy="60" r="10" fill="#5aff8c" opacity=".9"/>
            <circle cx="75" cy="60" r="20" stroke="#5aff8c" stroke-width="1" opacity=".5"/>
            <circle cx="75" cy="60" r="30" stroke="#5aff8c" stroke-width="1" opacity=".25"/>
          </svg>
        </div>
        <h3>Find it in the dark</h3>
        <p>Glows for hours after charge &mdash; find your ball in the rough without a flashlight.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "How it glows", "settings": [] }
{% endschema %}
