{%- comment -%}
  Renders a product card matching the mockup's productCardHTML().
  Expects: product (object)
{%- endcomment -%}
{%- comment -%}
  "Coming soon" = not for sale yet (tagged coming-soon, or no price set).
  "Sold out" = a real product that's out of stock; keeps its price, can't be added.
{%- endcomment -%}
{%- assign p_soon = false -%}
{%- if product.tags contains 'coming-soon' or product.price == 0 -%}{%- assign p_soon = true -%}{%- endif -%}
{%- assign p_sold_out = false -%}
{%- unless p_soon or product.available -%}{%- assign p_sold_out = true -%}{%- endunless -%}
{%- assign is_multi = false -%}
{%- if product.tags contains 'fleet-pack' or product.handle contains 'fleet' or product.handle contains 'multi' -%}{%- assign is_multi = true -%}{%- endif -%}
{%- assign per_ball = product.price | divided_by: 9 -%}

<div class="product-card">
  {%- if p_soon -%}
    <div class="badge badge-soon">Coming soon</div>
  {%- elsif p_sold_out -%}
    <div class="badge badge-soon">Sold out</div>
  {%- elsif product.compare_at_price > product.price -%}
    {%- assign save_amount = product.compare_at_price | minus: product.price | money_without_trailing_zeros -%}
    <div class="badge">Save {{ save_amount }}</div>
  {%- elsif product.tags contains 'best-seller' -%}
    <div class="badge">Best seller</div>
  {%- endif -%}

  <a class="product-card-link" href="{{ product.url }}">
    <div class="product-photo">
      {%- if is_multi -%}
        <div class="multi-swatch" style="background:conic-gradient(from 0deg, var(--white) 0deg 120deg, var(--neon-magenta) 120deg 240deg, var(--glow-green) 240deg 360deg);"></div>
      {%- elsif p_soon -%}
        <div class="dashed"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3l2.3 5.5L20 10l-4.5 3.7L17 20l-5-3-5 3 1.5-6.3L4 10l5.7-1.5L12 3z"/></svg></div>
      {%- elsif product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title }}" loading="lazy" width="600" height="600">
      {%- endif -%}
    </div>
    <div class="product-info">
      {%- unless p_soon -%}{%- render 'rating-stars', product: product, class: 'product-stars' -%}{%- endunless -%}
      <h3>{{ product.title }}</h3>
      <p class="product-sku">{% if p_soon %}Upload a logo or mark{% else %}{{ product.selected_or_first_available_variant.sku | default: product.handle | upcase }}{% endif %}</p>
      <p class="product-desc">{{ product.description | strip_html | truncatewords: 14 }}</p>
      <div class="price-row">
        {%- if p_soon -%}
          <span class="price">TBD</span><span class="price-unit">notify me</span>
        {%- else -%}
          <span class="price">{{ product.price | money_without_trailing_zeros }}</span><span class="price-unit">{% if is_multi %}9 balls &middot; {{ per_ball | money_without_trailing_zeros }}/ea{% else %}sleeve of 3{% endif %}</span>
        {%- endif -%}
      </div>
    </div>
  </a>
  {%- if p_soon -%}
    <button class="add-btn" data-soon="true" aria-label="Notify me about {{ product.title }}">+</button>
  {%- elsif p_sold_out or product.has_only_default_variant == false -%}
    <a class="add-btn" href="{{ product.url }}" aria-label="View {{ product.title }}">+</a>
  {%- else -%}
    <button class="add-btn" data-variant-id="{{ product.selected_or_first_available_variant.id }}" aria-label="Add {{ product.title }} to cart">+</button>
  {%- endif -%}
</div>
