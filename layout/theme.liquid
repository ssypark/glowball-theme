<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ page_title }}{% unless page_title contains 'GlowBall' %} &mdash; GlowBall Industries{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description }}">{% else %}<meta name="description" content="Impact-activated light-up golf balls for night rounds, group outings, and corporate gifting. Tap it on your club, tee off after dark.">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
{{ 'site.css' | asset_url | stylesheet_tag }}
<style>img{max-width:100%;} [hidden]{display:none !important;}</style>

{{ content_for_header }}
</head>
<body>

<a href="#main" class="skip-link">Skip to content</a>

<nav class="topnav">
  <div class="nav-left">
    <a href="{{ routes.root_url }}" class="nav-logo"><img src="{{ 'logo.png' | asset_url }}" alt="">GLOWBALL</a>
    <ul class="nav-links">
      {%- liquid
        assign shop_current = ''
        if template.name == 'collection' or template.name == 'product' or template.name == 'index'
          assign shop_current = 'current'
        endif
      -%}
      {%- render 'nav-links', current_class: shop_current -%}
    </ul>
  </div>
  <div class="nav-actions">
    <a href="{{ routes.search_url }}" class="icon-btn" aria-label="Search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
    </a>
    <button class="icon-btn" id="cartOpenBtn" aria-label="Open cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 4h2l2.2 12.2a2 2 0 0 0 2 1.8h8a2 2 0 0 0 2-1.6L21 8H6"/><circle cx="10" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg>
      <span class="cart-count" id="cartCount" data-empty="{% if cart.item_count == 0 %}true{% else %}false{% endif %}">{{ cart.item_count }}</span>
    </button>
    {%- if shop.customer_accounts_enabled -%}
    <a href="{{ routes.account_url }}" class="icon-btn" aria-label="Account">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-4 5-6 8-6s6.5 2 8 6"/></svg>
    </a>
    {%- endif -%}
    <button class="icon-btn menu-toggle" id="menuOpenBtn" aria-label="Open menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/></svg>
    </button>
  </div>
</nav>

<div class="mobile-menu" id="mobileMenu">
  <div class="mobile-menu-head">
    <div class="nav-logo"><img src="{{ 'logo.png' | asset_url }}" alt="">GLOWBALL</div>
    <button class="icon-btn" id="menuCloseBtn" aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
    </button>
  </div>
  <ul>
    {%- render 'nav-links' -%}
  </ul>
</div>

{% unless template.name == 'index' %}
<div class="page-header">
  <div class="container">
    <div class="breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span class="sep">/</span>
      {% if template.name == 'product' %}
      <a href="{{ routes.all_products_collection_url }}">Shop</a><span class="sep">/</span>
      <span class="current">{{ product.title }}</span>
      {% else %}
      <span class="current">{{ page_title }}</span>
      {% endif %}
    </div>
  </div>
</div>
{% endunless %}

<main id="main">
{{ content_for_layout }}
</main>

<footer>
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand"><img src="{{ 'logo.png' | asset_url }}" alt="">GLOWBALL INDUSTRIES</div>
        <p class="footer-mission">Engineering light-up golf systems since the round you almost gave up on finishing. Golf Systems Division, Mission Ready.</p>
      </div>
      <div class="footer-col">
        <h4>Shop</h4>
        <ul>
          <li><a href="{{ routes.all_products_collection_url }}">All colors</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Multi-color pack</a></li>
          <li><a href="{{ routes.root_url }}#missions">Custom orders</a></li>
          {%- if pages['wholesale'].url != blank -%}<li><a href="{{ pages['wholesale'].url }}">Wholesale</a></li>{%- endif -%}
        </ul>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          {%- if pages['about'].url != blank -%}<li><a href="{{ pages['about'].url }}">About GlowBall</a></li>{%- endif -%}
          <li><a href="{{ routes.root_url }}#glows">Technology</a></li>
          {%- if blogs['journal'].url != blank -%}<li><a href="{{ blogs['journal'].url }}">Journal</a></li>{%- endif -%}
          {%- if pages['contact'].url != blank -%}<li><a href="{{ pages['contact'].url }}">Contact</a></li>{%- endif -%}
        </ul>
      </div>
      <div class="footer-col">
        <h4>Support</h4>
        <ul>
          <li><a href="{{ routes.root_url }}#faq">FAQ</a></li>
          {%- if shop.shipping_policy != blank -%}<li><a href="{{ shop.shipping_policy.url }}">Shipping</a></li>{%- endif -%}
          {%- if shop.refund_policy != blank -%}<li><a href="{{ shop.refund_policy.url }}">Returns</a></li>{%- endif -%}
          {%- if shop.customer_accounts_enabled -%}<li><a href="{{ routes.account_url }}">Track order</a></li>{%- endif -%}
          {%- if shop.privacy_policy != blank -%}<li><a href="{{ shop.privacy_policy.url }}">Privacy policy</a></li>{%- endif -%}
          {%- if shop.terms_of_service != blank -%}<li><a href="{{ shop.terms_of_service.url }}">Terms of service</a></li>{%- endif -%}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} GlowBall Industries &middot; Golf Systems Division</span>
      <span>Secure checkout &middot; Visa &middot; Mastercard &middot; Amex &middot; Shop Pay</span>
      <div class="footer-social">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 4v9.5a3.5 3.5 0 1 1-3-3.46"/><path d="M14 4c.5 2.5 2 4 5 4"/></svg></a>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="5" width="20" height="14" rx="3"/><path d="M10 9l6 3-6 3z" fill="currentColor" stroke="none"/></svg></a>{%- endif -%}
      </div>
    </div>
  </div>
</footer>

<div class="overlay" id="overlay"></div>
<aside class="cart-drawer" id="cartDrawer" aria-label="Shopping cart">
  <div class="cart-head">
    <h3>Cart</h3>
    <button class="cart-close" id="cartCloseBtn" aria-label="Close cart">&times;</button>
  </div>
  <div class="cart-items" id="cartItems">
    <p class="cart-empty">Your cart is empty. The fairway is dark &mdash; go fix that.</p>
  </div>
  <div class="cart-foot">
    <div class="cart-subtotal"><span>Subtotal</span><span id="cartSubtotal">$0</span></div>
    <a href="{{ routes.cart_url }}" class="btn btn-solid cart-checkout" id="checkoutBtn">Checkout</a>
  </div>
</aside>

{{ 'site.js' | asset_url | script_tag }}
</body>
</html>
